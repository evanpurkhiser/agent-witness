[Unit]
Description=Remote SSH agent with phone-based authorization
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/agent-witness --config /etc/agent-witness.toml serve
RuntimeDirectory=agent-witness
RuntimeDirectoryMode=0700
StateDirectory=agent-witness
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
